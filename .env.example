# Sign-in for the approver
APPROVER_PASSWORD=
SESSION_SECRET=            # long random string, signs the login cookie
CRON_SECRET=               # long random string, Vercel sends it to /api/cron/daily

# Supabase (leave empty to run on built-in demo data)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY= # server only, never expose to the browser

# Zoho Inventory (leave empty until you are ready to connect)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_DC=in                 # in, com, eu, au or ca
